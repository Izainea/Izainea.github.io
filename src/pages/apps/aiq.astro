  .cap-text code, .code, .stdout, .desc code { font-family: var(--mono); }
  .cap-text code, .desc code { font-size: 0.86em; }
  .cell { display: flex; flex-direction: column; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; background: var(--surface); }
