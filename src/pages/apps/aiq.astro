  .viz .legend span::before { content: ""; display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 0.4rem; background: var(--sw); vertical-align: -1px; }
  .viz .orbit { display: flex; align-items: center; gap: 0.8rem; font-family: var(--mono); font-size: 0.78rem; }
  .viz .orbit input { flex: 1; accent-color: var(--accent); }
  @media (max-width: 900px) { .cap { grid-template-columns: minmax(0, 1fr); } }
</style>

<script src="https://cdn.jsdelivr.net/pyodide/v0.27.7/full/pyodide.js" is:inline></script>
<script is:inline>
(async function () {
  var status = document.getElementById('lab-status');
  var statusText = document.getElementById('lab-status-text');
  var runs = document.querySelectorAll('button.run');
  var COL = { S: 'var(--c-app)', R: 'var(--c-fil)', O: 'var(--muted)', I: 'var(--c-fil)' };
  var CAPAS = ['var(--c-fil)', 'var(--c-doc)', 'var(--c-inv)', 'var(--c-app)', 'var(--c-blog)', 'var(--muted)'];

  // Puente Python -> JS: el código de cada celda deja en `out` un dict serializable.
  var HELPERS = [
    'import json, sys, io',
    'def viz_quiver(Q, matriz=None, titulo_matriz="A", capas=None, centro=None, orbita=None):',
    '    V = [str(v) for v in Q.Q0]',
    '    E = [[str(a), str(Q.source(a)), str(Q.target(a))] for a, _, _ in Q.Q1]',
    '    d = {"vertices": V, "arrows": E}',
    '    if matriz is not None: d["matriz"] = [[int(x) for x in row] for row in matriz]; d["titulo_matriz"] = titulo_matriz',
    '    if capas is not None: d["capas"] = capas; d["centro"] = str(centro)',
    '    if orbita is not None: d["orbita"] = orbita',
    '    return d',
  ].join('\n');

  function el(tag, attrs, parent) {
    var e = document.createElementNS('http://www.w3.org/2000/svg', tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    if (parent) parent.appendChild(e);
    return e;
  }
  function drawQuiver(host, d, colorOf) {
    var n = d.vertices.length, W = 460, H = 300, cx = W / 2, cy = H / 2, R = Math.min(W, H) / 2 - 46;
    var pos = {};
    d.vertices.forEach(function (v, i) { var a = -Math.PI / 2 + (i * 2 * Math.PI) / n; pos[v] = [cx + R * Math.cos(a), cy + R * Math.sin(a)]; });
    var svg = el('svg', { viewBox: '0 0 ' + W + ' ' + H, role: 'img', 'aria-label': 'Quiver con ' + n + ' vértices y ' + d.arrows.length + ' flechas' });
    var defs = el('defs', {}, svg);
    var m = el('marker', { id: 'v-ah', viewBox: '0 0 10 10', refX: '9', refY: '5', markerWidth: '7', markerHeight: '7', orient: 'auto' }, defs);
    el('path', { d: 'M0 1L9 5L0 9z', 'class': 'v-ah' }, m);
    // flechas paralelas y lazos se curvan
    var seen = {};
    d.arrows.forEach(function (a) {
      var s = pos[a[1]], t = pos[a[2]], key = a[1] + '>' + a[2];
      seen[key] = (seen[key] || 0) + 1;
      var k = seen[key], bend = (k - 1) * 22 * (k % 2 ? 1 : -1) + (seen[a[2] + '>' + a[1]] ? 18 : 0);
      var path;
      if (a[1] === a[2]) {
        path = 'M' + (s[0] + 8) + ' ' + (s[1] - 8) + ' C ' + (s[0] + 50) + ' ' + (s[1] - 50) + ', ' + (s[0] - 30) + ' ' + (s[1] - 60) + ', ' + (s[0] - 3) + ' ' + (s[1] - 12);
      } else {
        var dx = t[0] - s[0], dy = t[1] - s[1], L = Math.hypot(dx, dy), ux = dx / L, uy = dy / L;
        var mx = (s[0] + t[0]) / 2 - uy * bend, my = (s[1] + t[1]) / 2 + ux * bend;
        var sx = s[0] + ux * 13, sy = s[1] + uy * 13, ex = t[0] - ux * 15, ey = t[1] - uy * 15;
        path = 'M' + sx + ' ' + sy + ' Q ' + mx + ' ' + my + ' ' + ex + ' ' + ey;
        var lx = (s[0] + t[0]) / 2 - uy * (bend + 10), ly = (s[1] + t[1]) / 2 + ux * (bend + 10);
        var tl = el('text', { x: lx, y: ly + 4, 'text-anchor': 'middle', 'class': 'v-alab' }, svg); tl.textContent = a[0];
      }
      el('path', { d: path, 'class': 'v-edge', 'marker-end': 'url(#v-ah)' }, svg);
    });
    d.vertices.forEach(function (v) {
      var p = pos[v];
      el('circle', { cx: p[0], cy: p[1], r: 11, 'class': 'v-node', fill: colorOf(v), 'data-v': v }, svg);
      var t = el('text', { x: p[0], y: p[1] - 17, 'text-anchor': 'middle', 'class': 'v-lab' }, svg); t.textContent = v;
    });
    host.appendChild(svg);
    return svg;
  }
  function drawMatrix(host, d) {
    var wrap = document.createElement('div');
    var title = document.createElement('div'); title.className = 'mat-title'; title.textContent = 'Matriz ' + (d.titulo_matriz || 'A') + ' · filas = origen, columnas = destino';
    wrap.appendChild(title);
    var tbl = document.createElement('table'), tr = document.createElement('tr');
    tr.appendChild(document.createElement('th'));
    d.vertices.forEach(function (v) { var th = document.createElement('th'); th.textContent = v; tr.appendChild(th); });
    tbl.appendChild(tr);
    d.matriz.forEach(function (row, i) {
      var r = document.createElement('tr'), th = document.createElement('th'); th.textContent = d.vertices[i]; r.appendChild(th);
      row.forEach(function (x) { var td = document.createElement('td'); td.textContent = x; if (x) td.style.color = 'var(--accent)'; r.appendChild(td); });
      tbl.appendChild(r);
    });
    wrap.appendChild(tbl); host.appendChild(wrap);
  }
  function legend(host, items) {
    var lg = document.createElement('div'); lg.className = 'legend';
    items.forEach(function (it) { var s = document.createElement('span'); s.style.setProperty('--sw', it[1]); s.textContent = it[0]; lg.appendChild(s); });
    host.appendChild(lg);
  }
  function render(host, d) {
    host.textContent = ''; host.hidden = false;
    if (d.tabla) {
      var tbl = document.createElement('table'), tr = document.createElement('tr');
      d.cabecera.forEach(function (h) { var th = document.createElement('th'); th.textContent = h; tr.appendChild(th); }); tbl.appendChild(tr);
      d.tabla.forEach(function (row) { var r = document.createElement('tr'); row.forEach(function (x) { var td = document.createElement('td'); td.textContent = x; r.appendChild(td); }); tbl.appendChild(r); });
      host.appendChild(tbl); return;
    }
    if (d.capas) {
      var capaDe = {}; Object.keys(d.capas).forEach(function (g) { d.capas[g].forEach(function (v) { capaDe[v] = +g; }); });
      drawQuiver(host, d, function (v) { return v === d.centro ? 'var(--ink)' : (v in capaDe ? CAPAS[capaDe[v] % CAPAS.length] : 'var(--rule)'); });
      legend(host, [['c = ' + d.centro, 'var(--ink)']].concat(Object.keys(d.capas).sort().map(function (g) { return ['A_' + g + '(c)', CAPAS[g % CAPAS.length]]; })).concat([['sin camino a c', 'var(--rule)']]));
      return;
    }
    if (d.orbita) {
      var t = 0, svg = drawQuiver(host, d, function (v) { return COL[d.orbita[0][v]] || 'var(--rule)'; });
      var bar = document.createElement('div'); bar.className = 'orbit';
      var lab = document.createElement('span'); lab.textContent = 't = 0';
      var rng = document.createElement('input'); rng.type = 'range'; rng.min = 0; rng.max = d.orbita.length - 1; rng.value = 0; rng.id = 'orbit-' + host.id;
      rng.setAttribute('aria-label', 'Paso de la órbita');
      rng.addEventListener('input', function () {
        t = +rng.value; lab.textContent = 't = ' + t;
        svg.querySelectorAll('circle[data-v]').forEach(function (c) { c.setAttribute('fill', COL[d.orbita[t][c.getAttribute('data-v')]] || 'var(--rule)'); });
      });
      bar.appendChild(lab); bar.appendChild(rng); host.appendChild(bar);
      legend(host, Object.keys(COL).filter(function (s) { return d.orbita.some(function (c) { return Object.values(c).indexOf(s) >= 0; }); }).map(function (s) { return [s, COL[s]]; }));
      return;
    }
    drawQuiver(host, d, function () { return 'var(--c-inv)'; });
    if (d.matriz) drawMatrix(host, d);
  }

  var py;
  try {
    py = await loadPyodide({ indexURL: 'https://cdn.jsdelivr.net/pyodide/v0.27.7/full/' });
    statusText.textContent = 'Instalando numpy, scipy, pandas, networkx, sympy y matplotlib…';
    await py.loadPackage(['numpy', 'scipy', 'pandas', 'networkx', 'sympy', 'matplotlib', 'micropip']);
    statusText.textContent = 'Instalando aiq-quivers desde PyPI…';
    await py.runPythonAsync('import micropip\nawait micropip.install("aiq-quivers==1.2.1")');
    py.runPython(HELPERS);
    status.classList.add('ready');
    statusText.textContent = 'Listo: aiq-quivers 1.2.1 corriendo en tu navegador. Ejecuta cualquier celda.';
    runs.forEach(function (b) { b.disabled = false; });
  } catch (e) {
    status.classList.add('error');
    statusText.textContent = 'No se pudo cargar Python en el navegador: ' + e.message + '. Puedes copiar el código y ejecutarlo con pip install aiq-quivers.';
    return;
  }

  runs.forEach(function (b) {
    b.addEventListener('click', async function () {
      var id = b.getAttribute('data-run');
      var code = document.getElementById('code-' + id).value;
      var out = document.getElementById('out-' + id), viz = document.getElementById('viz-' + id);
      b.disabled = true; out.hidden = false; out.className = 'stdout'; out.textContent = 'Ejecutando…';
      try {
        py.runPython('sys.stdout = io.StringIO()\nout = None');
        await py.runPythonAsync(code);
        var text = py.runPython('sys.stdout.getvalue()');
        out.textContent = text || '(sin salida)';
        var res = py.runPython('json.dumps(out) if out is not None else "null"');
        var d = JSON.parse(res);
        if (d) render(viz, d); else viz.hidden = true;
      } catch (e) {
        out.className = 'stdout err';
        out.textContent = String(e.message || e).split('\n').slice(-12).join('\n');
      } finally { b.disabled = false; }
    });
  });
  document.querySelectorAll('button.reset').forEach(function (b) {
    b.addEventListener('click', function () {
      var ta = document.getElementById('code-' + b.getAttribute('data-reset'));
      ta.value = ta.getAttribute('data-original');
    });
  });
})();
</script>
