      <circle class="dot" cx="380" cy="430" r="4.5"></circle><circle class="dot" cx="450" cy="430" r="4.5"></circle><circle class="dot" cx="520" cy="430" r="4.5"></circle><circle class="dot" cx="590" cy="430" r="4.5"></circle>
      <path class="ln" d="M388 430L441 430" marker-end="url(#wah)"></path><path class="ln" d="M458 430L511 430" marker-end="url(#wah)"></path><path class="ln" d="M528 430L581 430" marker-end="url(#wah)"></path>
